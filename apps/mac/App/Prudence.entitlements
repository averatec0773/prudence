<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Empty, and that is the decision.

	No App Sandbox: a sandboxed app's Application Support resolves inside its own container
	rather than to the directory the CLI writes, it may not read outside that container at
	all, and SQLite needs write access to the WAL index to read a WAL database. It also could
	not execute a uv-installed `prudence`. Developer ID with the hardened runtime and no
	entitlements is exactly Decaf's configuration and the only one this app can have.
-->
<plist version="1.0">
<dict/>
</plist>
