    "observations.empty.project.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No behaviour here clears both floors: at least five sessions on each side of the split, and enough distance between the two medians to be worth printing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有行为同时越过两个门槛：分界两边各至少五个会话，且两个中位数之间的差距足够值得写出来。"
          }
        }
      }
    },
