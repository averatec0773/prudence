    "observation.sentence.alive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, your %2$@ sessions %3$@ still have %4$@ of their lines at head (median); the %5$@ %6$@, %7$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，你有 %2$@ 个会话%3$@，它们的代码行中位数有 %4$@ 仍留在 head；%6$@的 %5$@ 个会话为 %7$@。"
          }
        }
      }
    },
    "observation.sentence.rework": {
      "extractionState": "manual",
      "localizations": {
