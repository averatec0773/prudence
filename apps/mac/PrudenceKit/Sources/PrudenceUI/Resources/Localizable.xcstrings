    "overview.noOutcomes.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No commit in this range is credited with a line that could be followed. A repository where other people commit has its outcomes withheld rather than guessed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个范围内没有提交被认定写下了可追踪的代码行。有其他人提交的仓库，其成果会被保留不报，而不是猜测。"
          }
        }
      }
    },
    "overview.noOutcomes.title": {
