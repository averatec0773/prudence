    "observations.floor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An observation splits your own sessions in two at one threshold and takes each side's median. These are descriptions of what happened, not advice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条观察把你自己的会话按某个阈值分成两边，各取中位数。这些是对已发生事情的描述，不是建议。"
          }
        }
      }
    },
    "observations.scope.pooled": {
