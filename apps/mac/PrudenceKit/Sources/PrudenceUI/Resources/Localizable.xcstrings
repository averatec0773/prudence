    "overview.whatBecame.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "alive_30d / measured_30d and reworked / lines, both from app_outcomes_by_week. A week whose 30-day mark has not arrived is a gap, never a zero. The pale wide line is that week's mean coverage: the share of a counted commit's added lines the session itself wrote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "alive_30d / measured_30d 与 reworked / lines，都来自 app_outcomes_by_week。30 天标记尚未到达的周是断口，不是零。浅色宽线是该周的平均覆盖率：计入的提交所新增的代码行中，由会话自己写下的比例。"
          }
        }
      }
    },
